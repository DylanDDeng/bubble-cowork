{
  "appId": "com.aegis.desktop",
  "productName": "Aegis",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "beforePack": "scripts/before-pack-prepare-deepseek.cjs",
  "afterPack": "scripts/after-pack-verify-deepseek.cjs",
  "files": [
    "dist-electron/**/*",
    "dist-react/**/*",
    "package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "node_modules/**/*",
    "!node_modules/@anthropic-ai/claude-agent-sdk-*",
    "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
    "!node_modules/**/@anthropic-ai/claude-agent-sdk-*",
    "!node_modules/**/@anthropic-ai/claude-agent-sdk-*/**/*",
    "!node_modules/@qoder-ai/qoder-agent-sdk/dist/_bundled",
    "!node_modules/@qoder-ai/qoder-agent-sdk/dist/_bundled/**/*",
    "!node_modules/**/@qoder-ai/qoder-agent-sdk/dist/_bundled/**/*",
    // Render-only icon set (133M): Vite already bundles the used icons into
    // dist-react — the main process never requires @tabler.
    "!node_modules/@tabler",
    "!node_modules/@tabler/**/*",
    "!node_modules/**/@tabler",
    "!node_modules/**/@tabler/**/*",
    // Compiler (61M): no runtime code path requires it — the Pi agent loads TS
    // via jiti and every package declaring it lists it as a devDependency.
    // Boundary: if Bubble's TS/Vue LSP tooling is ever wired up
    // (typescript-language-server resolves tsserver from this package),
    // remove these lines.
    "!node_modules/typescript",
    "!node_modules/typescript/**/*",
    "!node_modules/**/node_modules/typescript",
    "!node_modules/**/node_modules/typescript/**/*"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*"
  ],
  "extraResources": [
    {
      "from": "dist-electron/electron/preload.cjs",
      "to": "preload.cjs"
    },
    {
      "from": "dev-fixtures/deepseek-harness",
      "to": "deepseek-harness",
      "filter": [
        "cordis.yml",
        "runtime-bin.mjs",
        "runtime-resume-shim.mjs",
        "package.json"
      ]
    },
    {
      "from": "dev-fixtures/deepseek-harness/node_modules",
      "to": "deepseek-harness/node_modules",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "artifactName": "Aegis-${version}-${arch}-mac.${ext}",
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ],
    "category": "public.app-category.developer-tools"
  },
  "win": {
    "target": ["portable", "nsis"],
    "signAndEditExecutable": false
  },
  "nsis": {
    "artifactName": "Aegis-${version}-win-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "Aegis-${version}-win-${arch}-portable.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Development"
  },
  "appImage": {
    "artifactName": "Aegis-${version}-linux-${arch}.${ext}"
  },
  "publish": [
    {
      "provider": "github"
    }
  ]
}
